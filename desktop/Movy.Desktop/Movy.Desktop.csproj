<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Movy</AssemblyName>
    <Product>Movy Desktop</Product>
    <Description>Native Windows client for Movy</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Movy.Core/Movy.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Content Include="../../shared/native_account.js" Link="Assets/native_account.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/native_resolver.js" Link="Assets/native_resolver.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/LICENSE.txt" Link="ThirdParty/WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/NOTICE.txt" Link="ThirdParty/WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Resolve the actual restored pack directories before Content target paths
       are assigned. SDK patches change runtime versions and package locations. -->
  <Target Name="IncludeMovyRuntimeNotices" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_MovyCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_MovyDesktopRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <Error Condition="'@(_MovyCoreRuntimePack)' == '' or '@(_MovyDesktopRuntimePack)' == ''"
           Text="Required runtime packs were not resolved; cannot include their license notices." />
    <ItemGroup>
      <Content Include="@(_MovyCoreRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" Link="ThirdParty/DotNET-Runtime-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(_MovyDesktopRuntimePack->'%(PackageDirectory)/LICENSE')" Link="ThirdParty/WPF-Runtime-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
